# ============================================
# IOT Service Configuration
# ============================================

# Server
SERVER_PORT=8083
SERVER_HOST=0.0.0.0
GIN_MODE=debug

# MySQL Database
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_DATABASE=smart_parking_iot
MYSQL_MAX_OPEN_CONNS=25
MYSQL_MAX_IDLE_CONNS=5

# Redis Cache
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_POOL_SIZE=10

# MinIO/S3
S3_ENDPOINT=localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=smart-parking
S3_USE_SSL=false

# Eureka Discovery
EUREKA_SERVER_URL=http://localhost:8761/eureka
SERVICE_NAME=iot-service
SERVICE_INSTANCE_ID=iot-service-1
SERVICE_IP_ADDRESS=localhost

# External Services
IA_SERVICE_URL=http://localhost:8084
PARKING_SERVICE_URL=http://localhost:8082

# RabbitMQ (Optional)
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
RABBITMQ_EXCHANGE=smart-parking-events
RABBITMQ_QUEUE=iot-events

# Logging
LOG_LEVEL=info
LOG_FILE=logs/iot-service.log
